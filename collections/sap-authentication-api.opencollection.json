{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP AI Core Addresses Authentication API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{subdomain}.authentication.{region}.hana.ondemand.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sap Authenticate and Create a Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ai.{region}.cfapps.{landscape}.hana.ondemand.com/v2/Login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates a user against SAP Business One and returns a session cookie for subsequent API calls."
        },
        {
          "info": {
            "name": "Sap End the Current Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ai.{region}.cfapps.{landscape}.hana.ondemand.com/v2/Logout"
          },
          "docs": "Terminates the current authenticated session and invalidates the session cookie."
        }
      ]
    }
  ],
  "bundled": true
}