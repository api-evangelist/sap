            "method": "POST",
            "url": "https://{server}:50000/b1s/v1/Login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates a user against SAP Business One and returns a session cookie for subsequent API calls."
        },
