          "info": {
            "name": "Sap End the Current Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}:50000/b1s/v1/Logout"
          },
          "docs": "Terminates the current authenticated session and invalidates the session cookie."
        }
